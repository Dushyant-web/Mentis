# Base URL of the FastAPI backend, no trailing slash.
# Local: http://localhost:8000   Deployed: https://your-api-domain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth web client ID. Must match GOOGLE_CLIENT_ID on the backend, and the
# deployed domain must be listed as an Authorized JavaScript origin in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
