# ============ REQUIRED — app boot nahi hoga inke bina ============

# PostgreSQL connection string
DATABASE_URL=postgresql://user@localhost:5432/neuro_app

# Session signing key. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-me-with-a-64-char-random-hex-string


# ============ REQUIRED IN PRODUCTION ============

# Comma-separated CORS origins. MUST contain the exact frontend origin —
# no trailing slash, no wildcard (credentials mode rejects wildcards).
# Defaults to localhost only, so the deployed frontend is blocked without this.
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.netlify.app

# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (Web application).
# Must be the same ID the frontend uses. Google sign-in fails without it.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Direct download links to the model artifacts. Only used when the files are not
# already at backend/model/ — which is the case on any fresh deploy, since the
# .pkl files are too large for git. A GitHub Release asset works well here.
MODEL_URL=
SCALER_URL=


# ============ OPTIONAL — sensible defaults ============

# Response caching + rate limiting. Both degrade gracefully if unset or
# unreachable: the app runs, just without caching and without rate limits.
REDIS_URL=redis://localhost:6379

# How long an access token stays valid. Default: 24
JWT_EXPIRE_HOURS=24

# SQLAlchemy connection pool. Defaults: 10 and 20.
# On a 1-CPU instance, 5 / 10 is usually a better fit.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
