# ---- Database ----
# Local:  postgresql://<user>@localhost:5432/neuro_app
# Hosted: the connection string your provider gives you (Neon, Supabase, RDS, Railway...)
DATABASE_URL=postgresql://user@localhost:5432/neuro_app

# ---- Cache ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Generate a fresh one:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-me-with-a-64-char-random-hex-string
# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ---- CORS ----
# Comma-separated. Must include the exact origin the frontend is served from.
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# ---- Model artifacts ----
# Only used when model/dyslexia_model.pkl and model/scaler.pkl are not already on disk.
# Must be direct download links to the .pkl files, publicly readable.
MODEL_URL=
SCALER_URL=
